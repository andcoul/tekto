# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# RevenueCat webhook
REVENUECAT_WEBHOOK_SECRET=<your-revenuecat-webhook-secret>

# Cloudflare Stream
CLOUDFLARE_STREAM_API_TOKEN=<your-cf-stream-token>
CLOUDFLARE_ACCOUNT_ID=<your-cf-account-id>

# Supabase (auto-set by supabase CLI for local dev)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# Coach system-prompt version — the semantic cache is purged when this changes
COACH_PROMPT_VERSION=2026-11-v1

# Embeddings: the coach cache uses the Edge Runtime's built-in gte-small model (Supabase.ai) — no key needed
